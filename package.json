{
  "name": "wcx-pi-preset",
  "version": "1.0.0",
  "description": "wcx 的 Pi preset：常用扩展、技能与提示词一键打包",
  "keywords": ["pi-package", "pi", "preset"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yayawcx/wcx-pi-preset.git"
  },
  "scripts": {
    "verify": "node scripts/verify-manifest.mjs",
    "prepack": "node scripts/verify-manifest.mjs"
  },
  "files": ["extensions", "skills", "prompts", "themes", "node_modules"],
  "dependencies": {
    "@bacnh85/pi-init": "^0.1.7",
    "@dietrichgebert/ponytail": "^5.1.0",
    "@juicesharp/rpiv-ask-user-question": "^2.13.5",
    "@lanlance/pi-recap": "^0.3.0",
    "@mohndoe/pi-atlas": "^0.2.1",
    "@narumitw/pi-btw": "^0.61.1",
    "@narumitw/pi-goal": "^0.54.11",
    "@narumitw/pi-plan-mode": "^0.59.2",
    "@plannotator/pi-extension": "^0.28.16",
    "@tintinweb/pi-subagents": "^0.20.0",
    "@vanillagreen/pi-skills-manager": "^2.0.4",
    "bigpowers": "^2.88.9",
    "pi-cache-optimizer": "^2.8.24",
    "pi-input-history": "^1.1.3",
    "pi-powerline-footer": "^0.20.0",
    "pi-session-name": "^0.1.7",
    "pi-web-access": "^0.39.0",
    "statusline-pi": "^1.4.0"
  },
  "bundleDependencies": [
    "@bacnh85/pi-init",
    "@dietrichgebert/ponytail",
    "@juicesharp/rpiv-ask-user-question",
    "@lanlance/pi-recap",
    "@mohndoe/pi-atlas",
    "@narumitw/pi-btw",
    "@narumitw/pi-goal",
    "@narumitw/pi-plan-mode",
    "@plannotator/pi-extension",
    "@tintinweb/pi-subagents",
    "@vanillagreen/pi-skills-manager",
    "bigpowers",
    "pi-cache-optimizer",
    "pi-input-history",
    "pi-powerline-footer",
    "pi-session-name",
    "pi-web-access",
    "statusline-pi"
  ],
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/@bacnh85/pi-init/extensions/index.js",
      "node_modules/@dietrichgebert/ponytail/pi-extension/index.js",
      "node_modules/@lanlance/pi-recap/extensions/recap.ts",
      "node_modules/@narumitw/pi-goal/dist/index.ts",
      "node_modules/@narumitw/pi-plan-mode/dist/index.ts",
      "node_modules/@narumitw/pi-btw/dist/index.ts",
      "node_modules/pi-web-access/dist",
      "node_modules/pi-cache-optimizer/index.ts",
      "node_modules/pi-session-name/src/index.ts",
      "node_modules/pi-input-history/index.ts",
      "node_modules/pi-powerline-footer/index.ts",
      "node_modules/@tintinweb/pi-subagents/src/index.ts",
      "node_modules/@mohndoe/pi-atlas/src/index.ts",
      "node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "node_modules/statusline-pi/src/index.ts",
      "node_modules/@vanillagreen/pi-skills-manager/extensions/skills-manager.ts",
      "node_modules/bigpowers/extensions/omp-hooks.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/@dietrichgebert/ponytail/skills",
      "node_modules/bigpowers/.pi/skills"
    ],
    "prompts": ["./prompts", "node_modules/bigpowers/.pi/prompts"],
    "themes": ["./themes"]
  }
}
